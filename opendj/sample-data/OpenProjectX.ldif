# Base DN
dn: dc=openprojectx,dc=org
objectClass: top
objectClass: dcObject
objectClass: organization
dc: openprojectx
o: OpenProjectX

# Organizational Units
dn: ou=people,dc=openprojectx,dc=org
objectClass: top
objectClass: organizationalUnit
ou: people

dn: ou=apps,dc=openprojectx,dc=org
objectClass: top
objectClass: organizationalUnit
ou: apps

dn: ou=groups,dc=openprojectx,dc=org
objectClass: top
objectClass: organizationalUnit
ou: groups


#5.3 Groups (Departments & Roles)
dn: cn=it,ou=groups,dc=openprojectx,dc=org
objectClass: groupOfNames
cn: it
member: cn=dummy,dc=openprojectx,dc=org

dn: cn=sales,ou=groups,dc=openprojectx,dc=org
objectClass: groupOfNames
cn: sales
member: cn=dummy,dc=openprojectx,dc=org

dn: cn=hr,ou=groups,dc=openprojectx,dc=org
objectClass: groupOfNames
cn: hr
member: cn=dummy,dc=openprojectx,dc=org

dn: cn=apps,ou=groups,dc=openprojectx,dc=org
objectClass: groupOfNames
cn: apps
member: cn=dummy,dc=openprojectx,dc=org


#5.4 Human Users
dn: uid=alice,ou=people,dc=openprojectx,dc=org
objectClass: top
objectClass: inetOrgPerson
objectClass: posixAccount
