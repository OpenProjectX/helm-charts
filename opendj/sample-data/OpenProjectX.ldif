description: CI/CD automation bot
userPassword: REPLACE_IT

# 5.6 Group Memberships
dn: cn=it,ou=groups,dc=openprojectx,dc=org
changetype: modify
add: member
member: uid=alice,ou=people,dc=openprojectx,dc=org


dn: cn=apps,ou=groups,dc=openprojectx,dc=org
changetype: modify
add: member
member: uid=spark-job-runner,ou=apps,dc=openprojectx,dc=org
member: uid=ci-bot,ou=apps,dc=openprojectx,dc=org



