#5.5 Application Accounts
dn: uid=spark-job-runner,ou=apps,dc=openprojectx,dc=org
objectClass: top
objectClass: account
objectClass: simpleSecurityObject
uid: spark-job-runner
description: Spark batch job service account
userPassword: REPLACE_IT


dn: uid=ci-bot,ou=apps,dc=openprojectx,dc=org
objectClass: top
objectClass: account
objectClass: simpleSecurityObject
